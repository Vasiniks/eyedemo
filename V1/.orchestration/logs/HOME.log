+/* ---- HOME: large book-exam band (client "add a LARGE Book exam") ------------
+ * Full-width Ink band carrying only the verbatim live CTA label. Large type,
+ * large tap target (72px desktop / 64px mobile, full row width). Motion is
+ * the CTA family language (fill wipe + arrow travel + ≤4px magnetic +
+ * press scale, transforms/opacity only); RM = static final state. */
+.eyeq-bookband {
+  max-width: none;
+  background: var(--eyeq-ink);
+  color: var(--eyeq-paper);
+  padding: 56px var(--eyeq-margin);
+}
+.eyeq-bookband__inner {
+  max-width: 880px;
+  margin: 0 auto;
+}
+.eyeq-cta--band {
+  --eyeq-cta-h: 72px;
+  width: 100%;
+  min-height: var(--eyeq-cta-h);
+  justify-content: center;
+  padding: 20px 32px;
+  font-size: clamp(16px, 1.6vw, 19px);
+  letter-spacing: 0.08em;
+  border-radius: 2px;
+}
+.eyeq-cta--band:focus-visible {
+  outline: 2px solid var(--eyeq-lamp-amber);
+  outline-offset: 4px;
+}
+/* White-act dock: the band fills the 640px column right after the film. */
+.eyeq-white__cta {
+  width: 100%;
+}
+.eyeq-white__cta .eyeq-bookband {
+  background: none;
+  padding: 0;
+}
+.eyeq-white__cta .eyeq-bookband__inner {
+  max-width: none;
+}
+@media (max-width: 767px) {
+  .eyeq-bookband {
+    padding: 40px 20px;
+  }
+  .eyeq-cta--band {
+    --eyeq-cta-h: 64px;
+    font-size: 16px;
+    padding: 18px 20px;
+  }
+}
+
+/* ---- HOME: featured brands + insurance name lists (B §9 / §5 verbatim) -----
+ * Ledger rows in the Services dialect (Fraunces numerals + name); names are
+ * unlinked plain text exactly as the logos are unlinked on the live site. */
+.eyeq-brands__list,
+.eyeq-insurance__list {
+  list-style: none;
+  margin: 48px 0 0;
+  padding: 0;
+  border-top: 1px solid var(--eyeq-hairline-light-strong);
+  display: grid;
+  grid-template-columns: 1fr 1fr;
+  column-gap: 48px;
+}
+@media (max-width: 700px) {
+  .eyeq-brands__list,
+  .eyeq-insurance__list {
+    grid-template-columns: 1fr;
+  }
+}
+.eyeq-brands__list li,
+.eyeq-insurance__list li {
+  display: grid;
+  grid-template-columns: 64px 1fr;
+  gap: 24px;
+  padding: 22px 0;
+  border-bottom: 1px solid var(--eyeq-hairline-light);
+  align-items: baseline;
+}
+.eyeq-brands__name {
+  font-family: var(--eyeq-font-display);
+  font-size: 22px;
+  font-weight: 400;
+  margin: 0;
+  color: var(--eyeq-ink);
+}
+/* Visit onward link (mirrors the Services "more" link dialect). */
+.eyeq-visit__contact {
+  display: inline-block;
+  margin-top: 32px;
+  color: var(--eyeq-ink);
+  font-size: 14px;
+  font-weight: 500;
+  letter-spacing: 0.06em;
+  text-underline-offset: 4px;
+}
+
 /* ---- WHITE polish: ledger hairline draws + staggered text ----------------- */
 .eyeq-ledger-draw {
   position: relative;
 }

