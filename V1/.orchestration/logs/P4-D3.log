from PIL import Image
import numpy as np
def band(f, x0, x1, y0, y1, thr=30):
    img = np.array(Image.open(f'docs/phase4/qa/D/{f}.png').convert('L'))
    sub = img[y0:y1, x0:x1] > thr
    rows = np.where(sub.any(axis=1))[0]
    cols = np.where(sub.any(axis=0))[0]
    return (rows.min()+y0, rows.max()+y0, rows.max()-rows.min()+1, cols.min()+x0, cols.max()+x0, cols.max()-cols.min()+1)
