from PIL import Image
import numpy as np
img = np.array(Image.open('docs/phase4/qa/D/r2-w1-seq-tiny-1440.png').convert('L'))
mask = img > 30
cols_any = mask.any(axis=0)
# find contiguous runs
runs = []
s = None
for i, v in enumerate(cols_any):
    if v and s is None: s = i
    if not v and s is not None: runs.append((s, i)); s = None
if s is not None: runs.append((s, len(cols_any)))
for a, b in runs:
    sub = mask[:, a:b]
    ys = np.where(sub.any(axis=1))[0]
    print(f'x {a}-{b} (w {b-a}), y {ys.min()}-{ys.max()}, bright {sub.sum()}')
