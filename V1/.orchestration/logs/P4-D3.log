import math
def mulberry32(seed):
    s = seed & 0xFFFFFFFF
    def rnd():
        nonlocal s
        s = (s + 0x6D2B79F5) & 0xFFFFFFFF
        t = (s ^ (s >> 15)) * (1 + s) & 0xFFFFFFFF
        t = (t + ((t ^ (t >> 7)) * (61 + t) & 0xFFFFFFFF)) & 0xFFFFFFFF
        t ^= t >> 14
        return (t & 0xFFFFFFFF) / 4294967296
    return rnd
def clamp01(x): return max(0, min(1, x))
def expo(t): return 1 - 2**(-10*clamp01(t))
def lerp(a,b,t): return a+(b-a)*t
# W1 config
start, flight, stagger = 0.7, 0.06, 0.011
spawnZ, spawnX, spawnY, seed = (-22,-18), 6, 3, 7
rng = mulberry32(seed)
spawns = [((rng()-0.5)*2*spawnX, (rng()-0.5)*2*spawnY, lerp(spawnZ[0],spawnZ[1],rng())) for _ in range(8)]
names = ['MJ','RB','PR','MM','PE','OA','TI','VE']
slots = [(-0.26,0.03,-0.04),(0.27,0.05,-0.04),(-0.30,0.175,-0.12),(0.01,0.20,-0.12),(0.30,0.17,-0.12),(-0.27,-0.10,-0.26),(0.01,-0.13,-0.26),(0.28,-0.10,-0.26)]
# note: arcAndTilt not applied here (approx)
for p in [0.747, 0.751, 0.764, 0.81]:
    fov = 35 + 8*(math.sin(math.pi*clamp01((p-0.7)/0.15)))**0.8
    tan = math.tan(math.radians(fov/2))
    print(f'--- p={p} FOV={fov:.1f} ---')
    for i in range(8):
        t = clamp01((p-(start+i*stagger))/flight)
        e = expo(t)
        x = lerp(spawns[i][0], slots[i][0], e)
        y = lerp(spawns[i][1], slots[i][1], e)
        z = lerp(spawns[i][2], slots[i][2], e)
        d = 0.78 - z
        sx = 720 + (x-0)/(d*tan*1.6)*720
        sy = 450 - (y+0.02)/(d*tan)*450
        print(f'  {names[i]} t={t:.2f} e={e:.2f} sN={2**(-10*t):.2f} pos=({x:.2f},{y:.2f},{z:.2f}) screen=({sx:.0f},{sy:.0f})')
"
