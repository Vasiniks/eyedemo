[0m⚙ [0mblender_execute_blender_code {"code":"import bpy, math\n\nLX, WY, TH = 0.081, 0.030, 0.015  # half-extents: 162 x 60 x 30 mm\n\ndef make_variant(name, loc, color, fn):\n    bpy.ops.mesh.primitive_uv_sphere_add(segments=32, ring_count=16, location=loc)\n    ob = bpy.context.active_object\n    ob.name = name\n    mesh = ob.data\n    for v in mesh.vertices:\n        v.co.xyz = fn(v.co.x, v.co.y, v.co.z)\n    mod = ob.modifiers.new(\"Subdiv\", 'SUBSURF')\n    mod.levels = 1\n    mod.render_levels = 2\n    for p in mesh.polygons:\n        p.use_smooth = True\n    mat = bpy.data.materials.new(name + \"_Mat\")\n    mat.use_nodes = True\n    bsdf = next(n for n in mat.node_tree.nodes if n.type == 'BSDF_PRINCIPLED')\n    bsdf.inputs[\"Base Color\"].default_value = (*color, 1.0)\n    bsdf.inputs[\"Roughness\"].default_value = 0.6\n    mesh.materials.append(mat)\n    return ob\n\ndef flat_bottom(Z):\n    return -0.004 + (Z + 0.004) * 0.4 if Z < -0.004 else Z\n\ndef shape_A(x, y, z):  # LOZENGE — symmetric capsule plan, aerofoil section\n    nx = x\n    return (x*LX, y*WY*(1.0-0.25*nx*nx), flat_bottom(z*TH*(1.0-0.45*nx*nx)))\n\ndef shape_B(x, y, z):  # TEARDROP — wide at hinge end (-X), tapered +X\n    nx = x\n    t = (nx + 1.0) / 2.0\n    plan = 1.0 - 0.55*(t**1.6)\n    thin = 1.0 - 0.60*(t**1.8)\n    return (x*LX, y*WY*plan, flat_bottom(z*TH*thin))\n\ndef shape_C(x, y, z):  # WING — straight spine edge (-Y), curved opening edge, swept\n    nx = x\n    Y = y*WY\n    if y < 0:\n        Y = y*WY*0.45            # straighter spine side\n    else:\n        Y = y*WY*(1.0-0.30*nx*nx) # sculpted opening side\n    Y = Y + 0.010*nx*nx          # gentle sweep\n    Z = z*TH*(1.0-0.50*abs(nx)**1.7)\n    return (x*LX, Y, flat_bottom(Z))\n\nmake_variant(\"Sil_A_Lozenge\",  (-0.25, 0, 0.03), (0.55, 0.57, 0.60), shape_A)\nmake_variant(\"Sil_B_Teardrop\", ( 0.00, 0, 0.03), (0.60, 0.55, 0.50), shape_B)\nmake_variant(\"Sil_C_Wing\",     ( 0.25, 0, 0.03), (0.50, 0.58, 0.55), shape_C)\n\n# Frame all three in every 3D viewport\nfor win in bpy.context.window_manager.windows:\n    for area in win.screen.areas:\n        if area.type == 'VIEW_3D':\n            for space in area.spaces:\n                if space.type == 'VIEW_3D':\n                    space.shading.type = 'MATERIAL'\n            ctx = {'window': win, 'area': area, 'region': next(r for r in area.regions if r.type == 'WINDOW')}\n            try:\n                with bpy.context.temp_override(**ctx):\n                    bpy.ops.view3d.view_all(center=False)\n            except Exception as e:\n                print(\"view_all failed:\", e)\n\nbpy.ops.wm.save_as_mainfile()\nprint(\"VARIANTS:\", [o.name for o in bpy.data.objects if o.name.startswith(\"Sil_\")])\n","user_prompt":"You are a specialist agent in PHASE 3 (MODEL) of the EyeQ Vision Care cinematic homepage. Lead 3D artist owning the live Blender scene, designing an aerospace-inspired glasses case."}
