+/* Settled breathing: once a logo has landed (is-settled), its img drifts
+ * ±3px on a slow 7s loop — a barely-there hover that keeps the constellation
+ * alive while the film holds. Transform-only, linear-ish ease-in-out;
+ * runs on the img so it never fights the inline positioning transforms. */
+.bw-logo.is-settled > img {
+  animation: bw-breathe 7s ease-in-out infinite alternate;
+  will-change: transform;
+}
+@keyframes bw-breathe {
+  from { transform: translate3d(0, -2px, 0); }
+  to { transform: translate3d(0, 2.5px, 0); }
