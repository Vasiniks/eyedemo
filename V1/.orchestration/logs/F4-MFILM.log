import { chromium } from 'playwright';
const b = await chromium.launch();
const ctx = await b.newContext({ viewport: { width: 1512, height: 860 } });
const p = await ctx.newPage();
const errs = [];
p.on('pageerror', e => errs.push(e.message));
for (const [tag, src] of [['w1set', 303], ['w2set', 455]]) {
  const prog = ((src-1)/614).toFixed(4);
  await p.goto('http://127.0.0.1:5704/v1-waves.html?p=' + prog, { waitUntil: 'domcontentloaded' });
  await p.waitForTimeout(2500);
  await p.screenshot({ path: '/tmp/mfilm-' + tag + '-1512.png' });
  const boxes = await p.evaluate(() => [...document.querySelectorAll('.bw-item')].map(el => {
    const logo = el.firstElementChild;
    const r = logo.getBoundingClientRect();
    const cs = getComputedStyle(el);
    const lcs = getComputedStyle(logo);
    return { cls: logo.className.replace('bw-logo ',''), cx: Math.round(r.left + r.width/2), cy: Math.round(r.top + r.height/2), w: Math.round(r.width), op: cs.opacity, filt: lcs.filter.slice(0,24) };
  }));
  console.log(tag, JSON.stringify(boxes));
}
console.log('ERRS:', errs.length ? errs : 'none');
await b.close();
