import struct, json
# quick glb inspection: list node names via JSON chunk
for f in ['public/models/glasses.glb','public/models/case.glb']:
    with open(f,'rb') as fh:
        magic=fh.read(4); ver=struct.unpack('<I',fh.read(4))[0]; length=struct.unpack('<I',fh.read(4))[0]
        clen=struct.unpack('<I',fh.read(4))[0]; ctype=fh.read(4)
        j=json.loads(fh.read(clen).decode('utf-8'))
        print('===',f)
        for n in j.get('nodes',[]):
            print(' node:',n.get('name'), 'rot:',n.get('rotation'), 'trans:',n.get('translation'), 'children:',n.get('children'))
        print(' materials:',[m.get('name') for m in j.get('materials',[])])
        print()
"

