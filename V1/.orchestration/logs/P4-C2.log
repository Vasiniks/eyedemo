const { chromium } = require('playwright-core');
(async () => {
  const browser = await chromium.launch();
  const page = await browser.newPage({ viewport: { width: 1440, height: 900 } });
  const combos = [
    ['x','1','-1'], ['y','1','-1'], ['z','1','-1'],
    ['z','-1','1'], ['y','-1','1'], ['x','-1','1'],
  ];
  for (const [ax,sr,sl] of combos) {
    await page.goto('http://localhost:5117/dev-C.html?q=0&mode=both&ui=0&inspectFolded=1&foldAxis='+ax+'&signR='+sr+'&signL='+sl, { waitUntil: 'networkidle' });
    await page.waitForTimeout(5000);
    await page.screenshot({ path: '/tmp/fold-'+ax+'-'+sr+'-'+sl+'.png' });
    console.log('saved', ax, sr, sl);
  }
  await browser.close();
})();
