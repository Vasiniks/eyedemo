import struct, json, numpy as np
with open('public/models/glasses.glb','rb') as fh:
    fh.read(12)
    clen=struct.unpack('<I',fh.read(4))[0]; fh.read(4)
    j=json.loads(fh.read(clen).decode('utf-8'))
    blen=struct.unpack('<I',fh.read(4))[0]; fh.read(4)
    buf=fh.read(blen)
nodes=j['nodes']; meshes=j['meshes']; acc=j['accessors']; bv=j['bufferViews']
def get_acc(i):
    a=acc[i]; v=bv[a['bufferView']]
    off=(v.get('byteOffset',0)+a.get('byteOffset',0))
    comp={'SCALAR':1,'VEC2':2,'VEC3':3}[a['type']]
    dt=np.dtype('<f4')
    arr=np.frombuffer(buf, dtype=dt, count=a['count']*comp, offset=off).reshape(-1,comp)
    return arr
for ni,n in enumerate(nodes):
