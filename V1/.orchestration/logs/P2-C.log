<script>
  (function() {
    class MapBlockas2xctelks1vqsdd2uaigenblock275457fkhgkyg extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.iframe = this.querySelector('.ai-map-iframe-as2xctelks1vqsdd2uaigenblock275457fkhgkyg');
        if (this.iframe) {
          this.setupClickToActivate();
        }
      }

      setupClickToActivate() {
        const overlay = document.createElement('div');
        overlay.style.cssText = 'position: absolute; top: 0; left: 0; right: 0; bottom: 0; cursor: pointer; z-index: 1;';
        
        const wrapper = this.querySelector('.ai-map-wrapper-as2xctelks1vqsdd2uaigenblock275457fkhgkyg');
        if (wrapper && this.iframe) {
          this.iframe.style.pointerEvents = 'none';
          wrapper.appendChild(overlay);

          overlay.addEventListener('click', () => {
            this.iframe.style.pointerEvents = 'auto';
            overlay.style.display = 'none';
          });

          wrapper.addEventListener('mouseleave', () => {
            this.iframe.style.pointerEvents = 'none';
            overlay.style.display = 'block';
          });
        }
      }
    }

    customElements.define('map-block-as2xctelks1vqsdd2uaigenblock275457fkhgkyg', MapBlockas2xctelks1vqsdd2uaigenblock275457fkhgkyg);
  })();
