import numpy as np, cv2, glob
for p in [72, 100, 140, 240, 280, 320, 330, 360, 400]:
    strip = cv2.imread(f"/tmp/framegen_cal_{p}.png")
    H, W = strip.shape[:2]
    w = W // 4
    A, I1, I2, B = (strip[:, i*w:(i+1)*w] for i in range(4))
    for name, I, t in (("1/3", I1, 1/3), ("2/3", I2, 2/3)):
        blend = ((1-t)*A.astype(np.float32) + t*B.astype(np.float32)).astype(np.uint8)
        ga = cv2.cvtColor(A, cv2.COLOR_BGR2GRAY).astype(np.float32)
        gb = cv2.cvtColor(B, cv2.COLOR_BGR2GRAY).astype(np.float32)
        d = np.abs(ga - gb)
        d = cv2.GaussianBlur(d, (5, 5), 1.0)
        m = d > 6.0
        cov = m.mean()
        if cov < 0.002:
            print(f"pair {p} t={name}: static cov={cov:.4f} PASS"); continue
        gi = cv2.cvtColor(I, cv2.COLOR_BGR2GRAY).astype(np.float32)
        gbl = cv2.cvtColor(blend, cv2.COLOR_BGR2GRAY).astype(np.float32)
        r = np.abs(gi - gbl)[m].mean() / (d[m].mean() + 1.0)
        print(f"pair {p} t={name}: cov={cov:.3f} mot={d[m].mean():.1f} r={r:.3f}")
