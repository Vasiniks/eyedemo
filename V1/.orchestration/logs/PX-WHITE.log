+
+/* ---- WHITE polish: differentiated section entrances ------------------------
+ * About = clip wipe on media · Services = hairline ledger (above) + sticky H2
+ * Lenses = row clip wipes on the inverted block · Reviews = counter + card
+ * scale + stagger · Visit = ledger + card clip · Footer = rise + hairline.
+ * All expo.out 0.6–1.1s, once, transforms/opacity/clip only.
+ */
+.eyeq-e__reveal--clip {
+  opacity: 0;
+  clip-path: inset(0 0 100% 0);
+  transform: none;
+  transition:
+    clip-path 1.1s var(--eyeq-ease-out),
