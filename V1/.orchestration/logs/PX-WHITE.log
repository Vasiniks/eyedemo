+}
+.eyeq-e__reveal--clip img,
+.eyeq-e__reveal--clip video {
+  transform: scale(1.08);
+  transition: transform 1.2s var(--eyeq-ease-out);
+}
+.eyeq-e__reveal--clip.is-in img,
+.eyeq-e__reveal--clip.is-in video {
