+}
+.eyeq-ledger-draw.is-in > li:nth-child(2) { transition-delay: 0.08s; }
+.eyeq-ledger-draw.is-in > li:nth-child(3) { transition-delay: 0.16s; }
+.eyeq-ledger-draw.is-in > li:nth-child(4) { transition-delay: 0.24s; }
+.eyeq-ledger-draw.is-in > li:nth-child(5) { transition-delay: 0.32s; }
+.eyeq-ledger-draw.is-in > li:nth-child(6) { transition-delay: 0.4s; }
+.eyeq-ledger-draw.is-in > li:nth-child(7) { transition-delay: 0.48s; }
+.eyeq-ledger-draw.is-in > li:nth-child(2)::after { transition-delay: 0.08s; }
+.eyeq-ledger-draw.is-in > li:nth-child(3)::after { transition-delay: 0.16s; }
+.eyeq-ledger-draw.is-in > li:nth-child(4)::after { transition-delay: 0.24s; }
+.eyeq-ledger-draw.is-in > li:nth-child(5)::after { transition-delay: 0.32s; }
+.eyeq-ledger-draw.is-in > li:nth-child(6)::after { transition-delay: 0.4s; }
+.eyeq-ledger-draw.is-in > li:nth-child(7)::after { transition-delay: 0.48s; }
+/* Keep the authored borders as the resting state; the draw is the entrance. */
+.eyeq-white__ledger.eyeq-ledger-draw > li,
+.eyeq-services__rows.eyeq-ledger-draw > li,
+.eyeq-visit__rows.eyeq-ledger-draw > li {
+  border-bottom-color: transparent;
+}
+.eyeq-white__ledger.eyeq-ledger-draw.is-in > li,
+.eyeq-services__rows.eyeq-ledger-draw.is-in > li,
+.eyeq-visit__rows.eyeq-ledger-draw.is-in > li {
+  border-bottom-color: var(--eyeq-hairline-light);
