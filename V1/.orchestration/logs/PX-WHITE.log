+  }
+  .eyeq-cta:hover .eyeq-cta__arrows > span:last-child {
+    transform: none;
+    opacity: 1;
+  }
+}
+.eyeq-cta:active {
+  transform: scale(0.97);
+  transition: transform 0.16s ease-out;
+}
+
+/* ---- WHITE polish: ledger hairline draws + staggered text ----------------- */
+.eyeq-ledger-draw {
+  position: relative;
+}
+.eyeq-ledger-draw > li {
+  position: relative;
+  opacity: 0;
+  transform: translateY(14px);
+  transition:
+    opacity 0.8s var(--eyeq-ease-out),
