+/* ---- WHITE polish: masked H1 split lines + optical settle -----------------
+ * Motion language (PLAN-MASTER §8): expo.out entrances 0.6–1.1s, line stagger
+ * 0.08–0.12s, masked lines yPercent 110→0, transforms/opacity only
+ * (the font-variation settle below is the one asked-for exception), RM static.
+ */
+.eyeq-white__h1 {
+  display: block;
+}
+.eyeq-white__h1 .wline-mask {
+  display: block;
+  overflow: hidden;
+  padding-bottom: 0.09em;
+  margin-bottom: -0.09em;
+}
+.eyeq-white__h1 .wline {
+  display: block;
+  transform: translateY(110%);
+  opacity: 0;
+  will-change: transform;
+  font-variation-settings: "opsz" 72, "SOFT" 50, "WONK" 1;
+}
+.eyeq-white__h1.is-in .wline {
+  transform: translateY(0);
+  opacity: 1;
+  transition:
+    transform 1s var(--eyeq-ease-out),
+    opacity 0.7s ease-out;
+}
+/* Line stagger 0.10s (within 0.08–0.12 band). */
+.eyeq-white__h1.is-in .wline-mask:nth-child(2) .wline {
+  transition-delay: 0.1s;
+}
+.eyeq-white__h1.is-in .wline-mask:nth-child(3) .wline {
+  transition-delay: 0.2s;
+}
+.eyeq-white__h1.is-in .wline-mask:nth-child(4) .wline {
+  transition-delay: 0.3s;
+}
+/* Optical settle: once lines land, ease opsz/weight a touch (600ms). */
+.eyeq-white__h1.is-settled .wline {
+  font-variation-settings: "opsz" 60, "SOFT" 60, "WONK" 1;
+  transition:
+    transform 1s var(--eyeq-ease-out),
+    opacity 0.7s ease-out,
+    font-variation-settings 0.6s ease-out;
+}
+.eyeq-white__microcap,
+.eyeq-white__logo {
+  opacity: 0;
+  transform: translateY(18px);
+  transition:
+    opacity 0.85s var(--eyeq-ease-out),
+    transform 0.85s var(--eyeq-ease-out);
+}
+.eyeq-white-act.is-in .eyeq-white__microcap,
+.eyeq-white-act.is-in .eyeq-white__logo {
+  opacity: 1;
+  transform: none;
+}
+.eyeq-white-act.is-in .eyeq-white__logo {
+  transition-delay: 0.08s;
+}
+
+/* ---- WHITE polish: CTA fill wipe + arrow travel (fine pointer only) ------- */
+.eyeq-cta {
+  position: relative;
+  isolation: isolate;
+  overflow: hidden;
+}
+.eyeq-cta::before {
+  content: "";
+  position: absolute;
+  inset: 0;
+  z-index: 0;
+  background: #2a2b2e;
+  transform: scaleY(0);
+  transform-origin: 50% 100%;
+  transition: transform 0.4s var(--eyeq-ease-out);
+}
+.eyeq-cta--paper::before {
+  background: #e9e2d3;
+}
+.eyeq-cta__label,
+.eyeq-cta__arrows {
+  position: relative;
+  z-index: 1;
+}
+.eyeq-cta__arrows {
+  display: inline-grid;
+  overflow: hidden;
+  width: 1.2em;
+  height: 1.2em;
+  line-height: 1.2em;
+}
+.eyeq-cta__arrows > span {
+  grid-area: 1 / 1;
+  display: inline-block;
+  transition: transform 0.4s var(--eyeq-ease-out), opacity 0.3s ease-out;
+}
+.eyeq-cta__arrows > span:last-child {
+  transform: translateX(-130%);
+  opacity: 0;
+}
+@media (hover: hover) and (pointer: fine) {
+  .eyeq-cta:hover::before {
+    transform: scaleY(1);
+  }
+  .eyeq-cta:hover .eyeq-cta__arrows > span:first-child {
+    transform: translateX(130%);
