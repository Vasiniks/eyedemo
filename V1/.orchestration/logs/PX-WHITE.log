+/* Stagger helpers for review cards / lens rows (0.08 band). */
+.eyeq-stagger.is-in > *:nth-child(2) { transition-delay: 0.08s; }
+.eyeq-stagger.is-in > *:nth-child(3) { transition-delay: 0.16s; }
+.eyeq-stagger.is-in > *:nth-child(4) { transition-delay: 0.24s; }
