from PIL import Image
import glob, os
base='/Users/admin/Desktop/BUISNESS/EyeQ Vision Care/V1/assets/source'
for f in sorted(glob.glob(base+'/brands/*')+glob.glob(base+'/logo/*')+glob.glob(base+'/insurance/*')):
    try:
        im=Image.open(f).convert('RGBA')
        w,h=im.size
        # bbox of non-transparent
        alpha=im.split()[3]
        bbox=alpha.getbbox()
        # mean color of opaque pixels
        import collections
        px=[p[:3] for p in im.getdata() if p[3]>128]
        if px:
            n=len(px)
            mr=sum(p[0] for p in px)//n; mg=sum(p[1] for p in px)//n; mb=sum(p[2] for p in px)//n
            print(os.path.basename(f), f'{w}x{h}', 'inkbbox='+str(bbox), f'opaque_px={n}', f'mean_ink=#{mr:02X}{mg:02X}{mb:02X}')
        else:
            print(os.path.basename(f), f'{w}x{h}', 'FULLY TRANSPARENT? bbox='+str(bbox))
    except Exception as e:
        print(os.path.basename(f),'ERR',e)
"
