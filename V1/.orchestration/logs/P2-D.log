from PIL import Image
import os, glob
base='/Users/admin/Desktop/BUISNESS/EyeQ Vision Care/V1/assets/source'
for f in sorted(glob.glob(base+'/**/*.*', recursive=True)):
    if os.path.isdir(f): continue
    rel=f.replace(base+'/','')
    try:
        im=Image.open(f)
        w,h=im.size
        mode=im.mode
        has_alpha='yes' if (mode in ('RGBA','LA') or (mode=='P' and 'transparency' in im.info)) else ('check' if mode=='P' else 'no')
        # sample corners for transparency check on RGBA
        extra=''
        if mode=='RGBA':
            px=im.load()
            corners=[px[0,0][3],px[w-1,0][3],px[0,h-1][3],px[w-1,h-1][3]]
            extra=' corners_alpha='+str(corners)
        # dominant color: resize small, most common
        small=im.convert('RGB').resize((8,8))
        from collections import Counter
        c=Counter(small.getdata()).most_common(3)
        print(f'{rel} | {w}x{h} | {mode} | alpha={has_alpha}{extra} | top3={c}')
    except Exception as e:
        print(f'{rel} | ERROR {e}')
