from PIL import Image
import os
d='public/web/insurance-light'
for f in ['canada-life-min.png','desjardins.png','ia-financial-group.png','empire-life.png','sun-life.png']:
    im=Image.open(os.path.join(d,f))
    print(f, im.mode, im.size, 'extrema:', im.getextrema() if im.mode!='RGBA' else [im.getchannel(c).getextrema() for c in 'RGBA'])
