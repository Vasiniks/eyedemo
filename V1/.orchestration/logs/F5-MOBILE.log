BEATS=[('birdseye',1,30,0.047,'linear'),('tilt',30,70,0.064,'power2'),('takeout',70,145,0.120,'linear'),('expand',145,215,0.112,'power2'),('heroHold',215,235,0.030,'linear'),('spin',235,325,0.144,'power3'),('spinHold',325,325,0.010,'linear'),('burst',325,350,0.040,'expo'),('ring',350,386,0.058,'linear'),('collapse',386,411,0.040,'power3'),('sweep',411,470,0.095,'power3'),('sweepHold',470,470,0.008,'linear'),('zoom',470,533,0.101,'expo'),('dissolve',533,560,0.043,'power2'),('endcard',560,615,0.088,'linear')]
def ease(n,t):
    import math
    if n=='linear': return t
    if n=='power2': return 2*t*t if t<0.5 else 1-pow(-2*t+2,2)/2
    if n=='power3': return 4*t*t*t if t<0.5 else 1-pow(-2*t+2,3)/2
    if n=='expo':
        import math
        if t<=0: return 0
        if t>=1: return 1
        return pow(2,20*t-10)/2 if t<0.5 else (2-pow(2,-20*t+10))/2
def src2film(s): return (s-1)/614
total=sum(b[3] for b in BEATS)
# build segs
segs=[]; sc=0
for name,s0,s1,sh,e in BEATS:
    share=sh/total
    segs.append((name,src2film(s0),src2film(s1),sc,sc+share,e))
    sc+=share
segs[-1]=(segs[-1][0],segs[-1][1],segs[-1][2],1,1,segs[-1][5]) if False else (segs[-1][0],segs[-1][1],segs[-1][2],segs[-1][3],1,segs[-1][5])
def film2scroll(f):
    for name,f0,f1,s0,s1,e in segs:
        lo=min(f0,f1); hi=max(f0,f1)
        if lo-1e-9<=f<=hi+1e-9:
            if hi-lo<1e-12: return s0
            tgt=(f-f0)/(f1-f0)
            a,b=0,1
            for _ in range(24):
                m=(a+b)/2
                if ease(e,m)<tgt: a=m
                else: b=m
            return s0+((a+b)/2)*(s1-s0)
    return 0 if f<=0 else 1
for s in [1,70,145,215,280,368,440,500,600]:
    print(s, round(film2scroll(src2film(s)),5))
