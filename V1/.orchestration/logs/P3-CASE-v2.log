[0m⚙ [0mblender_execute_blender_code {"code":"import bpy, bmesh, math\nfrom mathutils import Vector\n# delete losers\nfor n in (\"SilA_Lozenge\",\"SilC_Wing\"):\n    o = bpy.data.objects.get(n)\n    if o:\n        m = o.data\n        bpy.data.objects.remove(o, do_unlink=True)\n        if m and m.users==0: bpy.data.meshes.remove(m)\n        print(\"deleted\", n)\nmat = bpy.data.materials[\"CaseGraphite_Placeholder\"]\ndef ring_points(w, hLo, hHi):\n    crown=hHi; bot=-hLo\n    zpart = crown-(hLo+hHi)/3.0\n    up = crown-zpart\n    return [(0.0,bot),(0.70*w,bot+0.05*hLo),(0.95*w,bot+0.55*hLo),\n        (0.99*w,zpart),(0.88*w,zpart+0.55*up),(0.45*w,crown-0.08*up),\n        (0.0,crown),(-0.45*w,crown-0.08*up),(-0.88*w,zpart+0.55*up),\n        (-0.99*w,zpart),(-0.95*w,bot+0.55*hLo),(-0.70*w,bot+0.05*hLo)]\ndef profB(u): return math.sin(math.pi*(u**0.8))**0.75\ndef hB(u): return 0.28+0.72*(math.sin(math.pi*min(max(u,0.03),0.97))**0.55)\nL,W,H = 0.166,0.062,0.028\nNU,R = 96,12\nmesh = bpy.data.meshes.new(\"CaseShell_Mesh\")\nobj = bpy.data.objects.new(\"Case_Shell\", mesh)\nbpy.context.collection.objects.link(obj)\nbm = bmesh.new()\nrows=[]\nfor i in range(NU):\n    u = 0.015+0.97*(i/(NU-1))\n    x=(u-0.5)*L; w=profB(u)*W*0.5\n    h=max(hB(u)*H,0.004); hLo,hHi=h*0.40,h*0.60\n    rows.append([bm.verts.new(Vector((x,y,z))) for (y,z) in ring_points(w,hLo,hHi)])\nbm.verts.ensure_lookup_table()\nfor i in range(NU-1):\n    for j in range(R):\n        bm.faces.new([rows[i][j],rows[i+1][j],rows[i+1][(j+1)%R],rows[i][(j+1)%R]])\nfor ri,xe in ((0,-L*0.5),(NU-1,L*0.5)):\n    cz=sum(v.co.z for v in rows[ri])/R\n    pole=bm.verts.new(Vector((xe,rows[ri][0].co.y,cz)))\n    ring=rows[ri] if ri==NU-1 else list(reversed(rows[ri]))\n    for j in range(R):\n        bm.faces.new([pole,ring[j],ring[(j+1)%R]])\nbm.to_mesh(mesh); bm.free()\nbpy.context.view_layer.objects.active=obj\nbpy.ops.object.mode_set(mode='EDIT')\nbpy.ops.mesh.select_all(action='SELECT')\nbpy.ops.mesh.normals_make_consistent(inside=False)\nbpy.ops.object.mode_set(mode='OBJECT')\nmn=min(v.co.z for v in obj.data.vertices); obj.location.z-=(mn-0.001)\nvg=obj.vertex_groups.new(name=\"PartingLine\")\nfor i in range(NU): vg.add([i*R+3,i*R+9],1.0,'REPLACE')\nss=obj.modifiers.new(\"Subsurf\",type='SUBSURF'); ss.levels=1; ss.render_levels=1\nbpy.ops.object.shade_smooth()\nobj.data.materials.append(mat)\n# measure (world bbox, subsurf off influence negligible at cage level — report cage + est.)\nimport mathutils\nwb=[obj.matrix_world @ Vector(c) for c in obj.bound_box]\nxs=[v[0] for v in wb]; ys=[v[1] for v in wb]; zs=[v[2] for v in wb]\nprint(f\"SHELL bbox mm: X={(max(xs)-min(xs))*1000:.1f} Y={(max(ys)-min(ys))*1000:.1f} Z={(max(zs)-min(zs))*1000:.1f}\")\nprint(f\"verts={len(obj.data.vertices)} faces={len(obj.data.polygons)}\")\nbpy.ops.wm.save_as_mainfile(filepath=bpy.data.filepath)\nprint(\"SAVED-M2-SHELL\")","user_prompt":"\"You are a specialist agent in PHASE 3 (MODEL) of the EyeQ Vision Care cinematic homepage. ID = CASE (v2 — RESTART). M2: delete losing variants, rebuild the SilB teardrop winner as ONE hi-res closed shell (NU=96) with slightly more crown (lo_frac 0.40), measure bbox in mm.\""}
[0m⚙ [0mblender_execute_blender_code {"code":"import bpy, bmesh\nfrom mathutils import Vector\nNU,R = 96,12\nshell = bpy.data.objects[\"Case_Shell\"]\nbm = bmesh.new(); bm.from_mesh(shell.data)\nbm.verts.ensure_lookup_table(); bm.edges.ensure_lookup_table(); bm.faces.ensure_lookup_table()\ndef vi(i,k): return i*R+k\npath = [vi(i,3) for i in range(NU)] + [vi(NU-1,k) for k in (2,1,0,11,10,9)] \\\n     + [vi(i,9) for i in range(NU-1,-1,-1)] + [vi(0,k) for k in (10,11,0,1,2)]\npairs = set()\nfor a in range(len(path)):\n    u,v = path[a], path[(a+1)%len(path)]\n    pairs.add((min(u,v),max(u,v)))\nloop_edges = set()\nfor e in bm.edges:\n    key = (min(e.verts[0].index,e.verts[1].index), max(e.verts[0].index,e.verts[1].index))\n    if key in pairs: loop_edges.add(e.index)\nprint(f\"loop: {len(path)} verts, matched {len(loop_edges)} edges (expect {len(path)})\")\n# seed = highest-z face (crown)\nseed = max(bm.faces, key=lambda f: sum(v.co.z for v in f.verts)/len(f.verts))\nflap = set([seed.index]); stack=[seed]\nwhile stack:\n    f = stack.pop()\n    for e in f.edges:\n        if e.index in loop_edges: continue\n        for lf in e.link_faces:\n            if lf.index not in flap:\n                flap.add(lf.index); stack.append(lf)\nbody = set(f.index for f in bm.faces) - flap\nprint(f\"flap faces={len(flap)} body faces={len(body)} total={len(bm.faces)}\")\nbm.free()\n# duplicate into two objects, delete opposite faces\ndef spawn(name, kill):\n    bpy.ops.object.select_all(action='DESELECT')\n    shell.select_set(True); bpy.context.view_layer.objects.active=shell\n    bpy.ops.object.duplicate()\n    o = bpy.context.active_object; o.name=name\n    o.data = o.data.copy(); o.data.name=name+\"_Mesh\"\n    bm2 = bmesh.new(); bm2.from_mesh(o.data)\n    bm2.faces.ensure_lookup_table()\n    for f in bm2.faces: f.select = (f.index in kill)\n    bm2.to_mesh(o.data); bm2.free()\n    bpy.ops.object.mode_set(mode='EDIT')\n    bpy.ops.mesh.delete(type='FACE')\n    bpy.ops.object.mode_set(mode='OBJECT')\n    # recalc normals outside\n    bpy.ops.object.mode_set(mode='EDIT')\n    bpy.ops.mesh.select_all(action='SELECT')\n    bpy.ops.mesh.normals_make_consistent(inside=False)\n    bpy.ops.object.mode_set(mode='OBJECT')\n    return o\nflap_o = spawn(\"Case_Flap\", body)\nbody_o = spawn(\"Case_Body\", flap)\nfor o in (flap_o, body_o):\n    print(o.name, f\"v={len(o.data.vertices)} f={len(o.data.polygons)}\")\n# boundary match check\ndef bverts(o):\n    s=set()\n    for e in o.data.edges:\n        if len(o.data.polygons)==0: break\n    # edges with single face: build from polygons\n    from collections import Counter\n    c=Counter()\n    for p in o.data.polygons:\n        vs=p.vertices\n        for a in range(len(vs)):\n            c[(min(vs[a],vs[(a+1)%len(vs)]),max(vs[a],vs[(a+1)%len(vs)]))]+=1\n    pts=[tuple(o.matrix_world @ o.data.vertices[v].co) for k in c if c[k]==1 for v in [k[0]]]\n    return pts\nimport math\npb, pf = bverts(body_o), bverts(flap_o)\nprint(f\"boundary verts body={len(pb)} flap={len(pf)}\")\n# nearest-distance check (both orders)\ndef maxmin(A,B):\n    m=0\n    for a in A:\n        d=min(math.dist(a,b) for b in B)\n        m=max(m,d)\n    return m\nprint(f\"boundary mismatch maxmin body->flap={maxmin(pb,pf)*1000:.4f}mm flap->body={maxmin(pf,pb)*1000:.4f}mm\")\n# hinge line from PartingLine group (-y rail)\nvg = shell.vertex_groups[\"PartingLine\"]\nys,zs=[],[]\nfor v in shell.data.vertices:\n    try: w=vg.weight(v.index)\n    except: continue\n    if w>0.5 and (shell.matrix_world @ v.co).y<0:\n        p=shell.matrix_world @ v.co; ys.append(p.y); zs.append(p.z)\nyh, zh = sum(ys)/len(ys), sum(zs)/len(zs)\nprint(f\"hinge rail n={len(ys)} y_h={yh*1000:.2f}mm z_h={zh*1000:.2f}mm\")\n# remove shell template, delete blockout SilB\nfor n in (\"Case_Shell\",\"SilB_Teardrop\"):\n    o=bpy.data.objects.get(n)\n    if o:\n        m=o.data; bpy.data.objects.remove(o,do_unlink=True)\n        if m and getattr(m,'users',1)==0: bpy.data.meshes.remove(m)\n        print(\"removed\",n)\nbpy.ops.wm.save_as_mainfile(filepath=bpy.data.filepath)\nprint(\"SAVED-M2-SPLIT\")","user_prompt":"\"You are a specialist agent in PHASE 3 (MODEL) of the EyeQ Vision Care cinematic homepage. ID = CASE (v2 — RESTART). M2: split the closed shell EXACTLY along the closed parting loop (rails + tip wraps) into Case_Body and Case_Flap via flood fill; verify zero-gap boundary match; compute hinge rail mean (y_h, z_h); remove template.\""}
[0m⚙ [0mblender_execute_blender_code {"code":"import bpy, math\nfrom mathutils import Vector\nbody = bpy.data.objects[\"Case_Body\"]; flap = bpy.data.objects[\"Case_Flap\"]\nyh, zh = -0.02212, 0.01839\n# --- 0.4mm reveal: body rim down ---\nbpy.ops.object.select_all(action='DESELECT')\nfor o,dz in ((body,-0.0004),(flap,0.0)):\n    bpy.context.view_layer.objects.active=o; o.select_set(True)\n    bpy.ops.object.mode_set(mode='EDIT')\n    bpy.ops.mesh.select_all(action='DESELECT')\n    bpy.ops.mesh.select_non_manifold()\n    bpy.ops.transform.translate(value=(0,0,dz))\n    bpy.ops.object.mode_set(mode='OBJECT')\n    o.select_set(False)\nprint(\"reveal done\")\n# --- solidify 1.8mm inward, rim filled ---\nfor o in (body,flap):\n    s=o.modifiers.new(\"Solidify\",type='SOLIDIFY')\n    s.thickness=0.0018; s.offset=-1.0; s.use_rim=True; s.use_even_offset=True\n    print(o.name,\"tris(cage)=%d\"%len(o.data.polygons))\n# --- Case_Root + open prop ---\nroot=bpy.data.objects.new(\"Case_Root\",None)\nbpy.context.collection.objects.link(root)\nroot[\"open\"]=0.0\nui=root.id_properties_ui(\"open\")\nui.update(min=0.0,soft_min=0.0,soft_max=1.0,description=\"Flap open 0..1\")\nbody.parent=root\nprint(\"root ok\")\n# --- flap origin to hinge line ---\nbpy.context.view_layer.objects.active=flap; flap.select_set(True)\nfor v in flap.data.vertices: v.co-=Vector((0,yh,zh))\nflap.location+=Vector((0,yh,zh))\nflap.select_set(False)\nprint(\"flap origin:\",tuple(round(v,5) for v in flap.location))\n# --- armature: 3 vertical bones on hinge line, chained w/ offset ---\narm_data=bpy.data.armatures.new(\"FlapRig\")\narm=bpy.data.objects.new(\"FlapRig\",arm_data)\nbpy.context.collection.objects.link(arm)\narm.parent=root\nbpy.context.view_layer.objects.active=arm\nbpy.ops.object.mode_set(mode='EDIT')\nxs=[-0.045,0.0,0.045]; names=[\"B_Hinge\",\"B_Mid\",\"B_Tip\"]; eb=[]\nfor n,x in zip(names,xs):\n    b=arm_data.edit_bones.new(n)\n    b.head=(x,yh,zh); b.tail=(x,yh,zh+0.02)\n    if eb: b.parent=eb[-1]; b.use_connect=False\n    eb.append(b)\nbpy.ops.object.mode_set(mode='OBJECT')\n# verify local X == world X for hinge rotation\nb0=arm.pose.bones[\"B_Hinge\"]\nlx=(b0.matrix.to_3x3() @ Vector((1,0,0)))\nprint(\"B_Hinge localX in armature space:\",tuple(round(v,3) for v in lx))\n# --- weights: smooth falloff hinge(t=0) -> front edge(t=1) ---\nflap.update_from_editmode(); mw=flap.matrix_world\nys=[(mw @ v.co).y for v in flap.data.vertices]\ny0,y1=yh,max(ys)\ndef sstep(a,b,x):\n    t=min(max((x-a)/(b-a),0.0),1.0); return t*t*(3-2*t)\ng1=flap.vertex_groups.new(name=\"B_Hinge\"); g2=flap.vertex_groups.new(name=\"B_Mid\"); g3=flap.vertex_groups.new(name=\"B_Tip\")\nfor v in flap.data.vertices:\n    t=sstep(y0,y0+(y1-y0)*0.45,(mw @ v.co).y)\n    w1=1.0-t; w3=sstep(0.55,1.0,(t)); w2=max(0.0,1.0-w1-w3)\n    s=w1+w2+w3\n    g1.add([v.index],w1/s,'REPLACE'); g2.add([v.index],w2/s,'REPLACE'); g3.add([v.index],w3/s,'REPLACE')\nmod=flap.modifiers.new(\"Armature\",type='ARMATURE'); mod.object=arm\n# order: Armature above Solidify/Subsurf? currently [Subsurf?, Solidify, Armature] — move Armature first\nwhile flap.modifiers.find(\"Armature\")>0:\n    bpy.context.view_layer.objects.active=flap\n    bpy.ops.object.modifier_move_up(modifier=\"Armature\")\nprint(\"mod order:\",[m.type for m in flap.modifiers])\nflap.parent=arm\n# --- drivers open -> bone rotX ---\nimport math as m\nfor bn,expr in ((\"B_Hinge\",\"open*0.5934\"),(\"B_Mid\",\"open*0.0698\"),(\"B_Tip\",\"open*0.0349-8*3.14159/180*sin(3.14159*open)\")):\n    pb=arm.pose.bones[bn]; pb.rotation_mode='XYZ'\n    fc=pb.driver_add(\"rotation_euler\",0)\n    d=fc.driver; d.type='SCRIPTED'; d.expression=expr\n    var=d.variables.new(); var.name=\"open\"; var.type='SINGLE_PROP'\n    var.targets[0].id=root; var.targets[0].data_path='[\"open\"]'\nprint(\"drivers ok\")\nbpy.ops.wm.save_as_mainfile(filepath=bpy.data.filepath)\nprint(\"SAVED-M2-RIG\")","user_prompt":"\"You are a specialist agent in PHASE 3 (MODEL) of the EyeQ Vision Care cinematic homepage. ID = CASE (v2 — RESTART). M2 rig: 0.4mm reveal groove on body rim, 1.8mm inward solidify both parts, Case_Root with open prop, flap origin to hinge line, 3-bone armature (B_Hinge/B_Mid/B_Tip) with smooth weight falloff + scripted drivers for elastic open.\""}
[0m⚙ [0mblender_execute_blender_code {"code":"import bpy\nfrom collections import Counter\nYH, ZH = -0.02212, 0.01839\nbody = bpy.data.objects[\"Case_Body\"]\nflap = bpy.data.objects[\"Case_Flap\"]\n# reveal groove: body rim down 0.4mm\nbm_count=0\nec = Counter()\nfor p in body.data.polygons:\n    vs = p.vertices\n    for a in range(len(vs)):\n        ec[(min(vs[a],vs[(a+1)%len(vs)]), max(vs[a],vs[(a+1)%len(vs)]))]+=1\nrim = set(v for k in ec if ec[k]==1 for v in [k[0],k[1]])\n# note: k[0] only adds one vert of edge; add both:\nrim = set()\nfor k in ec:\n    if ec[k]==1: rim.update(k)\nfor i in rim:\n    body.data.vertices[i].co.z -= 0.0004\nprint(f\"body rim verts lowered: {len(rim)}\")\nfor o in (body, flap):\n    bpy.context.view_layer.objects.active = o\n    s = o.modifiers.new(\"Wall\", type='SOLIDIFY')\n    s.thickness = 0.0018; s.offset = -1.0\n    s.use_even_offset = True; s.use_rim = True; s.use_quality_normals = True\n    # move Wall above Subsurf\n    while o.modifiers.find(\"Wall\") > o.modifiers.find(\"Subsurf\"):\n        bpy.ops.object.modifier_move_up(modifier=\"Wall\")\n    print(o.name, [m.type for m in o.modifiers])\n# flap origin to hinge line (0, YH, ZH)\nbpy.ops.object.select_all(action='DESELECT')\nbpy.context.view_layer.objects.active = flap; flap.select_set(True)\nbpy.context.scene.cursor.location = (0.0, YH, ZH)\nbpy.ops.object.origin_set(type='ORIGIN_CURSOR')\nprint(\"flap origin ->\", tuple(flap.location))\n# Case_Root + open prop (soft limits: overshoot keys allowed)\nroot = bpy.data.objects.new(\"Case_Root\", None)\nbpy.context.collection.objects.link(root)\nroot[\"open\"] = 0.0\nui = root.id_properties_ui(\"open\")\nui.update(min=0.0, soft_min=0.0, soft_max=1.0, description=\"Flap open 0..1\")\nbody.parent = root\nprint(\"root ok; body parented\")\nbpy.ops.wm.save_as_mainfile(filepath=bpy.data.filepath)\nprint(\"SAVED-M2A\")","user_prompt":"\"You are a specialist agent in PHASE 3 (MODEL) of the EyeQ Vision Care cinematic homepage. ID = CASE (v2 — RESTART). M2a: 0.4mm reveal groove on body rim, 1.8mm inward solidify with rim on both parts, flap origin to hinge line, Case_Root empty with open prop.\""}
