import struct, json
for f in ['public/models/case.glb','public/models/glasses.glb']:
    with open(f,'rb') as fh:
        fh.read(12)
        import struct
        cl=struct.unpack('<I',fh.read(4))[0]; ct=struct.unpack('<I',fh.read(4))[0]
        j=json.loads(fh.read(cl).decode('utf-8'))
        print('====',f,'accessors====')
        for i,a in enumerate(j.get('accessors',[])[:5]):
            print(i,a)
        print('total accessors',len(j.get('accessors',[])))
        print('total bufferViews',len(j.get('bufferViews',[])))
        # count tris
        tris=0
        for m in j.get('meshes',[]):
            for p in m.get('primitives',[]):
                idx=p.get('indices')
                if idx is not None:
                    acc=j['accessors'][idx]
                    tris+=acc['count']//3
                else:
                    acc=j['accessors'][p['attributes']['POSITION']]
                    tris+=acc['count']//3
        print('total tris',tris)
"
