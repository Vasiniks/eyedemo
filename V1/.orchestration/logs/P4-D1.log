        print('meshes:', [(m.get('name'), len(m.get('primitives',[])), [p.get('material') for p in m.get('primitives',[])], ['targets:'+str(len(p.get('targets',[])))+':'+','.join(p.get('extras',{}).get('targetNames',[]) if isinstance(p.get('extras'),dict) else []) for p in m.get('primitives',[])]) for m in j.get('meshes',[])])
        print('materials:', [m.get('name') for m in j.get('materials',[])])
