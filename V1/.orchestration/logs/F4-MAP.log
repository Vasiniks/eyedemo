+  border-radius: 999px;
+  pointer-events: none;
+  opacity: 0;
+  transition: opacity 0.18s ease;
+}
+.eyeq-map--live:hover .eyeq-map__hint,
+.eyeq-map--live:focus-within .eyeq-map__hint {
+  opacity: 1;
+}
+.eyeq-map--live.is-active .eyeq-map__hint {
+  opacity: 0;
+}
+@media (prefers-reduced-motion: reduce) {
+  .eyeq-map--live .eyeq-map__hint {
+    transition: none;
+  }
+}
