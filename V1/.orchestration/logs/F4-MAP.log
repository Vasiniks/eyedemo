+      <div
+        className={`eyeq-map eyeq-map--live${interactive ? ' is-active' : ''}`}
+        style={compact ? { aspectRatio: '16 / 10' } : undefined}
+        onClick={() => setActive(true)}
+        onMouseLeave={() => setActive(false)}
+        onTouchStart={() => setActive(true)}
