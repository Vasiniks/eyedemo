+type QAData = { __film?: { setProgress: (p: number) => void; getProgress: () => { p: number } } }
+type QAPage = { evaluate: (fn: (v: number) => void, arg: number) => Promise<unknown> } & {
+  evaluate: (fn: () => { p: number } | undefined) => Promise<{ p: number } | undefined>
+  waitForTimeout: (ms: number) => Promise<void>
+  screenshot: (opts: { path: string }) => Promise<void>
+}
+
+/**
+ * Drive to p, let the damped camera (λ=5.2, slow under software GL) converge,
+ * re-assert (a stray ScrollTrigger refresh can clobber the dev-only write),
+ * shoot, and verify p held across the shot. Retries the stop on drift.
+ */
+async function settleStop(
+  page: {
+    evaluate: (fn: string | ((v: number) => unknown), arg?: number) => Promise<unknown>
+    waitForTimeout: (ms: number) => Promise<void>
+    screenshot: (opts: { path: string }) => Promise<void>
+  },
+  outDir: string,
+  file: string,
+  p: number,
+): Promise<void> {
+  void outDir
+  for (let attempt = 0; attempt < 3; attempt++) {
+    await page.evaluate((v) => (window as unknown as QAData).__film?.setProgress(v as number), p)
+    // Damped camera (λ=5.2) converges slowly under software GL: settle long
+    // so the shot shows the settled state, not a transient.
+    await page.waitForTimeout(3500)
+    await page.evaluate((v) => (window as unknown as QAData).__film?.setProgress(v as number), p)
+    await page.waitForTimeout(600)
+    const before = (await page.evaluate(() => (window as unknown as QAData).__film?.getProgress())) as
+      | { p: number }
+      | undefined
+    // eslint-disable-next-line no-await-in-loop
+    await page.screenshot({ path: join(outDir, file) })
+    const after = (await page.evaluate(() => (window as unknown as QAData).__film?.getProgress())) as
+      | { p: number }
+      | undefined
+    if (
+      before &&
+      after &&
+      Math.abs(before.p - p) < 0.005 &&
+      Math.abs(after.p - p) < 0.005
+    ) {
+      return
+    }
+  }
+  const state = (await page.evaluate(() => (window as unknown as QAData).__film?.getProgress())) as
+    | { p: number }
+    | undefined
+  if (!state || Math.abs(state.p - p) >= 0.005) {
+    throw new Error(`stop ${file} progress drifted (p=${state?.p}, want ${p})`)
+  }
+}
+
