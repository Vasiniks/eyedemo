import numpy as np, xml.etree.ElementTree as ET
from PIL import Image
# 1. SVG well-formed, paths only, single color, tight viewBox
t = open('assets/logo/eyeq-logo.svg').read()
r = ET.fromstring(t)
assert r.tag.endswith('svg'), r.tag
paths = [e for e in r.iter() if e.tag.endswith('path')]
print('paths:', len(paths), '| root fill:', r.get('fill'), r.get('fill-rule'), '| viewBox:', r.get('viewBox'))
assert r.get('viewBox') == '16 21 777 300'
assert all(p.get('d','').startswith('M') and p.get('d','').endswith('Z') for p in paths)
bad = [e.tag for e in r.iter() if not (e.tag.endswith('svg') or e.tag.endswith('path'))]
assert not bad, bad
# 2. white.png: RGB==255 everywhere, alpha == original alpha
o = np.array(Image.open('assets/source/logo/eyeq-logo-header-original.png').convert('RGBA'))
w = np.array(Image.open('assets/logo/eyeq-logo-white.png'))
assert w.shape == o.shape == (373,800,4)
assert (w[...,:3]==255).all() and (w[...,3]==o[...,3]).all()
print('white.png OK: RGB=255 todo, alfa identico, opaque px:', (w[...,3]>127).sum())
# 3. white@2x
w2 = np.array(Image.open('assets/logo/eyeq-logo-white@2x.png'))
assert w2.shape == (746,1600,4) and (w2[...,:3]==255).all()
print('white@2x OK: 1600x746 RGB=255, opaque px:', (w2[...,3]>127).sum())
# 4. brands-light: RGB uniforme F2F0EC; alfa preservado (miu-miu green-trap check)
L=(242,240,236)
for n in ['maui-jim','ray-ban','prada','miu-miu','persol','oakley','tiffany','versace']:
    b = np.array(Image.open(f'assets/web/brands-light/{n}.png'))
    assert (b[...,:3]==L).all(), n
    s = np.array(Image.open(f'assets/source/brands/{n}.png').convert('RGBA'))
    # alfa del trim debe existir dentro del alfa original (bbox check en trim central)
    assert (b[...,3]>16).any(), n
    print(f'{n}: size={b.shape[1]}x{b.shape[0]} RGB ok, alfa-max={b[...,3].max()}')
src_alpha = np.array(Image.open('assets/source/brands/miu-miu.png').convert('RGBA'))[...,3]
print('miu-miu src transparent-pixel RGB sample (trap neutralized by recolor):',
      np.array(Image.open('assets/source/brands/miu-miu.png').convert('RGBA'))[0,0,:3])
# 5. insurance: sun-life fondo->transparente, tinta->opaca
s = np.array(Image.open('assets/web/insurance-light/sun-life.png'))
print('sun-life light: size', s.shape, 'corner alpha (bg):', s[2,2,3], '| center alpha (ink):', s[s.shape[0]//2, s.shape[1]//2, 3])
d = np.array(Image.open('assets/web/insurance-light/desjardins.png'))
print('desjardins light: size', d.shape, 'corner alpha:', d[2,2,3])
print('ALL CHECKS PASSED')
