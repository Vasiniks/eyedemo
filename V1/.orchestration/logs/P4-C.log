import struct, json
for f in ['public/models/case.opt.glb','public/models/glasses.opt.glb','public/models/case.glb','public/models/glasses.glb']:
    with open(f,'rb') as fh:
        data = fh.read()
    clen, ctype = struct.unpack('<II', data[12:20])
    js = json.loads(data[20:20+clen])
    print('='*20, f, len(data)//1024, 'KB')
    for i,n in enumerate(js.get('nodes',[])):
        print(f'  node[{i}] name={n.get(\"name\")!r} mesh={n.get(\"mesh\")} rot={n.get(\"rotation\")} trans={n.get(\"translation\")} scale={n.get(\"scale\")} children={n.get(\"children\")} weights={n.get(\"weights\")}')
    for i,m in enumerate(js.get('meshes',[])):
        for j,p in enumerate(m['primitives']):
