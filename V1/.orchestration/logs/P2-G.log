    mats=[m.name if m else '(none)' for m in me.materials]
    has_uv=bool(me.uv_layers)
    print(f"{ob.name!r} verts={nv} polys={npoly} tris={ntri} mats={mats} uv={has_uv}")
print(f'TOTAL verts={tot_v} tris={tot_t}')
