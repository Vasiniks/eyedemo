    if ob.type!='MESH': print(ob.name, ob.type); continue
    me=ob.data
    nv=len(me.vertices); npoly=len(me.polygons); ntri=sum(len(p.vertices)-2 for p in me.polygons)
    tot_v+=nv; tot_t+=ntri
